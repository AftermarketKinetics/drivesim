{
  "roots": [
    "tools",
    "crates",
    "server",
    "broker"
  ],
  "extensions": [
    ".py",
    ".rs",
    ".nix",
    ".sh",
    ".html"
  ],
  "ignore": [
    "**/target/**",
    "**/__pycache__/**",
    "**/fixtures/**",
    "**/.venv/**",
    "**/var/**"
  ],
  "sidecar_suffix": ".md"
}
